<% layout('layouts/boilerplate') %>
<%
  const displayTitle = listing.title || "Premium Stay";
  const displayLocation = [listing.location, listing.country].filter(Boolean).join(", ") || "Handpicked destination";
  const nightlyPrice = listing.price ? listing.price.toLocaleString("en-IN") : "0";
  const galleryImages = [
    listing.image && listing.image.url ? listing.image.url : "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1400&q=80",
    "https://images.unsplash.com/photo-1501117716987-c8e1ecb21003?auto=format&fit=crop&w=1400&q=80"
  ];
  const reviewCount = listing.reviews ? listing.reviews.length : 0;
  const averageRating = reviewCount
    ? (listing.reviews.reduce((sum, review) => sum + (review.rating || 0), 0) / reviewCount).toFixed(1)
    : "4.8";
  const propertyHighlights = [
    "Private and peaceful escape",
    "Thoughtfully curated interiors",
    "Instant access to top local attractions",
    "Trusted by guests from around the world"
  ];
  const amenities = [
    "Fast Wi-Fi",
    "Air conditioning",
    "Kitchen access",
    "Parking space",
    "Washer & dryer",
    "Self check-in",
    "Pool access",
    "Outdoor seating"
  ];
  const houseRules = [
    { rule: "Check-in after 2:00 PM", answer: "This gives the host enough time to prepare the space properly before arrival." },
    { rule: "Check-out before 11:00 AM", answer: "A standard checkout window helps keep the schedule smooth for the next guest." },
    { rule: "No smoking inside", answer: "This keeps the home fresh, clean, and comfortable for every visitor." },
    { rule: "No loud parties or events", answer: "The stay is designed for peaceful travel, not large gatherings." },
    { rule: "Pets allowed on request", answer: "The host can confirm pet-friendly arrangements before your stay." }
  ];
  const staySpecs = [
    { label: "Guests", value: "2 - 6" },
    { label: "Bedrooms", value: "2" },
    { label: "Bathrooms", value: "2" },
    { label: "Stay type", value: "Entire home" }
  ];
  const nearbyPlaces = [
    "City center and popular dining spots",
    "Nearby beach, park, or scenic viewpoint",
    "Local shops, cafes, and transport access"
  ];
%>

<div class="listing-show-page">
  <section class="listing-hero-card card shadow-sm">
    <div class="row g-0 align-items-stretch">
      <div class="col-lg-7">
        <div class="gallery-grid single-image">
          <div class="gallery-main">
            <img src="<%= galleryImages[0] %>" class="gallery-main-photo" alt="listing main image" data-gallery-image>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="show-hero-content h-100">
          <div class="show-badge-row">
            <span class="show-badge">Guest favourite</span>
            <span class="show-badge show-badge-alt"><%= averageRating %> rating</span>
          </div>
          <h1><%= displayTitle %></h1>
          <p class="show-location"><%= displayLocation %></p>
          <p class="show-description"><%= listing.description || "A polished and comfortable stay designed to feel warm, welcoming, and memorable from the moment you arrive." %></p>

          <div class="show-spec-grid">
            <% staySpecs.forEach((spec) => { %>
              <div class="show-spec-card">
                <span><%= spec.label %></span>
                <strong><%= spec.value %></strong>
              </div>
            <% }) %>
          </div>

          <div class="hero-price-row">
            <div class="hero-price">
              <strong>₹ <%= Math.round(listing.price * 1.10).toLocaleString("en-IN") %></strong>
              <small class="text-muted"> / night (incl. taxes)</small>
            </div>
          </div>

          <div class="show-action-row">
            <button type="button" class="btn btn-dark book-now-btn action-btn" data-book-now>Book now</button>
            <a href="#reviews" class="btn btn-dark hero-primary-btn action-btn">Read reviews</a>
            <a href="#where-youll-be" class="btn btn-outline-dark hero-secondary-btn action-btn">View location</a>
          </div>
          <p class="book-error-message d-none" data-book-error>Something went wrong. 400 Bad Request</p>

          <% if (currUser && listing.owner && listing.owner._id && listing.owner._id.equals(currUser._id)) { %>
            <div class="show-owner-actions">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit listing</a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-outline-dark">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <div class="row g-4 mt-4">
    <div class="col-lg-8">
      <div class="section-card">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">About this stay</p>
            <h3>Designed to feel real, calm, and fully prepared for your trip</h3>
          </div>
        </div>
        <p class="section-text">
          This AirHub stay comes with a balanced mix of comfort, convenience, and destination value. Guests can expect a well-kept space, easy booking flow, and a location that makes the trip feel effortless.
        </p>
        <div class="highlight-grid">
          <% propertyHighlights.forEach((highlight) => { %>
            <div class="highlight-pill"><i class="fa-solid fa-check"></i> <%= highlight %></div>
          <% }) %>
        </div>
      </div>

      <div class="section-card mt-4">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">What this place offers</p>
            <h3>Amenities that make the stay feel complete</h3>
          </div>
        </div>
        <div class="amenity-grid">
          <% amenities.forEach((amenity) => { %>
            <div class="amenity-pill"><i class="fa-solid fa-circle-check"></i> <%= amenity %></div>
          <% }) %>
        </div>
      </div>

      <div class="section-card mt-4">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">House rules</p>
            <h3>Simple expectations for a smooth stay</h3>
          </div>
        </div>
        <ul class="rule-list" role="list">
          <% houseRules.forEach((item, idx) => { %>
            <li class="rule-item" role="listitem">
              <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
              <div class="rule-copy">
                <button class="rule-toggle" type="button" aria-expanded="false" aria-controls="rule-answer-<%= idx %>">
                  <strong><%= item.rule %></strong>
                </button>
                <div id="rule-answer-<%= idx %>" class="rule-answer" data-rule-answer hidden>
                  <p><%= item.answer %></p>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="section-card mt-4" id="reviews">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">Reviews</p>
            <h3>Guest feedback</h3>
          </div>
          <div class="review-summary">
            <strong><%= averageRating %></strong>
            <span><%= reviewCount %> reviews</span>
          </div>
        </div>

        <% if (currUser) { %>
          <div class="review-form-card">
            <h4>Leave a review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
              <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div>
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control mb-3" required></textarea>
                <div class="invalid-feedback">Please add some comments.</div>
                <button class="btn btn-dark">Submit</button>
              </div>
            </form>
          </div>
        <% } %>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="review-grid mt-4">
            <% for (let review of listing.reviews) { %>
              <div class="review-card">
                <div class="review-card-top">
                  <h5>@<%= review.author ? review.author.username : "guest" %></h5>
                  <span class="review-score"><%= review.rating %>/5</span>
                </div>
                <p><%= review.comment %></p>
                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                <form class="mb-0" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted mt-3 mb-0">No reviews yet. Be the first guest to share an experience.</p>
        <% } %>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="section-card sticky-summary">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">Booking summary</p>
            <h3>Everything you need at a glance</h3>
          </div>
        </div>
        <div class="summary-stack">
          <div class="summary-row">
            <span>Owner</span>
            <strong><%= listing.owner ? listing.owner.username : "AirHub host" %></strong>
          </div>
          <div class="summary-row">
            <span>Location</span>
            <strong><%= displayLocation %></strong>
          </div>
          <div class="summary-row">
            <span>Nightly price</span>
            <strong>₹ <%= nightlyPrice %></strong>
          </div>
          <div class="summary-row">
            <span>Average rating</span>
            <strong><%= averageRating %> / 5</strong>
          </div>
        </div>
        <div class="summary-note">
          Free cancellation options, smooth check-in, and a stay experience shaped for modern travelers.
        </div>
        <button type="button" class="btn btn-dark w-100 mt-3 book-now-btn action-btn" data-book-now>Book now</button>
        <p class="book-error-message d-none" data-book-error>Something went wrong. 400 Bad Request</p>
        <a href="#listing-grid" class="btn btn-outline-dark w-100 mt-3 action-btn">Browse more stays</a>
      </div>

      <div class="section-card mt-4">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">Nearby highlights</p>
            <h3>What’s around the property</h3>
          </div>
        </div>
        <ul class="rule-list compact-list">
          <% nearbyPlaces.forEach((place) => { %>
            <li><i class="fa-solid fa-location-dot"></i> <%= place %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <div class="row mt-4" id="where-youll-be">
    <div class="col-lg-8">
      <div class="section-card">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">Where you'll be</p>
            <h3>Location preview</h3>
          </div>
        </div>
        <% if (googleMapsSearchUrl) { %>
          <a href="<%= googleMapsSearchUrl %>" target="_blank" rel="noopener noreferrer" class="map-link-card">
            <div id="map" class="mb-0">
              <div class="map-preview-content">
                <div class="map-preview-icon">
                  <i class="fa-solid fa-globe"></i>
                </div>
                <h5>Open in Google Maps</h5>
                <p>Click to view the exact location in a new tab.</p>
              </div>
            </div>
          </a>
        <% } else { %>
          <p class="text-muted mb-0">Map preview is unavailable for this listing.</p>
        <% } %>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="section-card">
        <div class="section-card-header">
          <div>
            <p class="section-kicker">Host notes</p>
            <h3>Helpful details</h3>
          </div>
        </div>
        <p class="section-text mb-0">
          The listing details on this page are intentionally filled with practical, realistic information so the page feels complete even for default or newly created homes.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const galleryImages = JSON.parse('<%- JSON.stringify(galleryImages) %>');
  const galleryImage = document.querySelector('[data-gallery-image]');
  const bookButtons = Array.from(document.querySelectorAll('[data-book-now]'));
  const bookErrorMessages = Array.from(document.querySelectorAll('[data-book-error]'));
  // Ensure the main image shows the primary image (no thumbnails)
  if (galleryImage && galleryImages && galleryImages.length) {
    galleryImage.src = galleryImages[0];
  }

  bookButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      const errorMessage = bookErrorMessages[index];
      if (errorMessage) {
        errorMessage.classList.remove('d-none');
      }
    });
  });

  // House rules accordion
  const ruleToggles = Array.from(document.querySelectorAll('.rule-toggle'));
  ruleToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      // collapse others (optional: single-open behavior)
      ruleToggles.forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          const otherAnswer = document.getElementById(other.getAttribute('aria-controls'));
          if (otherAnswer) otherAnswer.hidden = true;
        }
      });
      // toggle this one
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      const answerId = btn.getAttribute('aria-controls');
      const answerEl = document.getElementById(answerId);
      if (answerEl) answerEl.hidden = expanded;
    });
  });
</script>
