<% layout('layouts/boilerplate') %>

<div class="home-shell">
  <section class="home-hero" id="heroCarousel">
    <div class="hero-slide active" data-hero-slide>
      <div class="hero-content">
        <div class="hero-badge">Premium stays • Curated escapes</div>
        <h1>Discover luxury homes made for slow mornings and unforgettable nights.</h1>
        <p>From seaside villas to mountain retreats, find a stay that feels as refined as the destination itself.</p>
        <div class="hero-actions">
          <a href="#listing-grid" class="btn hero-primary">Explore stays</a>
          <a href="/listings/new" class="btn hero-secondary">List your property</a>
        </div>
        <div class="hero-stats">
          <div><strong>500+</strong><span>Luxury listings</span></div>
          <div><strong>4.9/5</strong><span>Guest rating</span></div>
          <div><strong>24/7</strong><span>Concierge support</span></div>
        </div>
      </div>

      <div class="hero-feature-card">
        <p class="feature-label">Featured destination</p>
        <h3>Malibu Coastline</h3>
        <p>Oceanfront villas, private chefs, and sunset decks.</p>
        <span>From ₹24,000 / night</span>
        <a href="#listing-grid" class="feature-book-btn">Book now</a>
      </div>
    </div>

    <div class="hero-slide" data-hero-slide>
      <div class="hero-content">
        <div class="hero-badge">New this season • Private retreats</div>
        <h1>Book a serene escape with rooftop views, private pools, and thoughtful comfort.</h1>
        <p>Every stay is chosen for design, comfort, and memorable experiences from arrival to checkout.</p>
        <div class="hero-actions">
          <a href="#listing-grid" class="btn hero-primary">Browse retreats</a>
          <a href="/listings/new" class="btn hero-secondary">Become a host</a>
        </div>
        <div class="hero-stats">
          <div><strong>120+</strong><span>New retreats</span></div>
          <div><strong>98%</strong><span>Repeat guests</span></div>
          <div><strong>Instant</strong><span>Booking access</span></div>
        </div>
      </div>

      <div class="hero-feature-card">
        <p class="feature-label">Featured destination</p>
        <h3>Alpine Hideaway</h3>
        <p>Cabins with fire pits, spa baths, and mountain views.</p>
        <span>From ₹18,500 / night</span>
        <a href="#listing-grid" class="feature-book-btn">Book now</a>
      </div>
    </div>

    <div class="hero-dots" aria-label="Hero slides">
      <button class="hero-dot active" data-hero-dot="0" aria-label="Show first slide"></button>
      <button class="hero-dot" data-hero-dot="1" aria-label="Show second slide"></button>
    </div>
  </section>

  <div class="section-heading">
    <div>
      <p class="section-kicker">Featured collection</p>
      <h2>Handpicked escapes for your next getaway</h2>
    </div>
  </div>

  <% const categories = [
    { name: "All", value: "all", icon: "🌍" },
    { name: "Beach", value: "beach", icon: "🏖️" },
    { name: "Mountains", value: "mountains", icon: "⛰️" },
    { name: "Villas", value: "villas", icon: "🏡" },
    { name: "Cabins", value: "cabins", icon: "🛖" },
    { name: "City", value: "city", icon: "🏙️" },
    { name: "Luxury", value: "luxury", icon: "💎" },
    { name: "Unique Stays", value: "unique", icon: "🌿" },
    { name: "Experiences", value: "experiences", icon: "✨" }
  ]; %>
  <div class="category-bar" id="categoryBar" role="tablist">
    <% const current = selectedCategory || 'all'; %>
    <% categories.forEach(cat => { %>
      <a class="category-item <%= cat.value === current ? 'active' : '' %>" href="/listings<%= cat.value === 'all' ? '' : '?category=' + encodeURIComponent(cat.value) %>" data-category="<%= cat.value %>">
        <div class="cat-icon"><%= cat.icon %></div>
        <div class="cat-label"><%= cat.name %></div>
      </a>
    <% }) %>
  </div>
  <button class="cat-arrow right" aria-label="Scroll categories right">›</button>
</div>

<!-- Listings Section -->
<% if (allListings.length === 0) { %>
  <div class="alert alert-info mt-4">No listings found.</div>
<% } else { %>
  <div class="listing-section mt-3">
    
    <button class="carousel-arrow left" aria-label="Scroll left">‹</button>
    <div id="listing-carousel" class="listing-carousel">
      <% for (let listing of allListings) { %>
        <% const keywords = ((listing.title || '') + ' ' + (listing.description || '')).toLowerCase(); %>
        <div class="listing-tile" data-category="<%= (listing.category || '').toLowerCase() %>" data-keywords="<%= keywords.replace(/"/g, '') %>">
          <div class="listing-links text-decoration-none position-relative">
            <a href="/listings/<%= listing._id %>">
              <div class="listing-image" role="img" aria-label="<%= listing.title %>">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
                <div class="badge-guest">Guest favourite</div>
              </div>
            </a>
            <form action="/wishlist/<%= listing._id %>" method="POST" class="wishlist-form position-absolute top-0 end-0 p-2">
              <button type="submit" class="fav-btn <%= wishlistIds && wishlistIds.includes(listing._id.toString()) ? 'active' : '' %>"
                aria-label="<%= wishlistIds && wishlistIds.includes(listing._id.toString()) ? 'Remove from wishlist' : 'Save listing' %>">
                <i class="fa-<%= wishlistIds && wishlistIds.includes(listing._id.toString()) ? 'solid' : 'regular' %> fa-heart"></i>
              </button>
            </form>
            <div class="card-body p-3">
              <div class="listing-title"><%= listing.title %></div>
              <div class="listing-meta">₹<%= Math.round(listing.price * 1.10).toLocaleString("en-IN") %> · <span class="rating">4.9</span></div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <button class="carousel-arrow right" aria-label="Scroll right">›</button>
  </div>
<% } %>

<script>
  const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
  const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
  let currentHeroIndex = 0;

  function showHeroSlide(index) {
    slides.forEach((slide, slideIndex) => {
      slide.classList.toggle('active', slideIndex === index);
    });
    dots.forEach((dot, dotIndex) => {
      dot.classList.toggle('active', dotIndex === index);
    });
    currentHeroIndex = index;
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      showHeroSlide(Number(dot.dataset.heroDot));
    });
  });

  setInterval(() => {
    const nextIndex = (currentHeroIndex + 1) % slides.length;
    showHeroSlide(nextIndex);
  }, 3500);
</script>
<script>
  // Carousel arrow scrolling for listings
  (function(){
    const carousel = document.getElementById('listing-carousel');
    const left = document.querySelector('.carousel-arrow.left');
    const right = document.querySelector('.carousel-arrow.right');
    if(!carousel) return;
    left.addEventListener('click', ()=>{
      carousel.scrollBy({left: -carousel.clientWidth * 0.8, behavior: 'smooth'});
    });
    right.addEventListener('click', ()=>{
      carousel.scrollBy({left: carousel.clientWidth * 0.8, behavior: 'smooth'});
    });
  })();
</script>
<script>
  // Category bar scrolling and in-place filtering.
  (function(){
    const categoryBar = document.getElementById('categoryBar');
    const leftCat = document.querySelector('.cat-arrow.left');
    const rightCat = document.querySelector('.cat-arrow.right');
    const categoryItems = Array.from(document.querySelectorAll('.category-item'));
    const listingTiles = Array.from(document.querySelectorAll('#listing-carousel .listing-tile'));

    function setActiveCategory(category) {
      categoryItems.forEach((item) => {
        item.classList.toggle('active', item.dataset.category === category);
      });

      listingTiles.forEach((tile) => {
        const tileCategory = (tile.dataset.category || '').toLowerCase();
        tile.style.display = category === 'all' || tileCategory === category ? '' : 'none';
      });

      const nextUrl = new URL(window.location.href);
      if (category === 'all') {
        nextUrl.searchParams.delete('category');
      } else {
        nextUrl.searchParams.set('category', category);
      }
      window.history.replaceState({}, '', nextUrl);
    }

    categoryItems.forEach((item) => {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        setActiveCategory(item.dataset.category || 'all');
      });
    });

    if(leftCat) leftCat.addEventListener('click', ()=> categoryBar.scrollBy({left:-120, behavior:'smooth'}));
    if(rightCat) rightCat.addEventListener('click', ()=> categoryBar.scrollBy({left:120, behavior:'smooth'}));

    const initialCategory = '<%= selectedCategory || "all" %>';
    setActiveCategory(initialCategory);
  })();
</script>
