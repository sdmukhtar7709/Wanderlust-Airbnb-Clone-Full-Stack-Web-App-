<% layout('layouts/boilerplate') %>

<div class="auth-page d-flex align-items-center justify-content-center" style="min-height:72vh; padding:2rem 1rem;">
    <div class="w-100" style="max-width:1100px;">
        <div class="row g-4 align-items-center">
            <!-- Visual / Branding column -->
            <div class="col-12 col-md-6 order-1 order-md-0">
                <div class="auth-visual rounded-3 shadow-sm" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1400&q=80');">
                    <div class="auth-visual-overlay">
                        <div class="brand">
                            <div class="brand-mark">🌍</div>
                            <div>
                                <div class="brand-name">Destino</div>
                                <div class="brand-tag">Curated stays, refined experiences</div>
                            </div>
                        </div>
                        <p class="visual-copy">Host gorgeous stays, welcome guests, and build a premium hosting experience.</p>
                    </div>
                </div>
            </div>

            <!-- Form column -->
            <div class="col-12 col-md-6 order-0 order-md-1">
                <div class="auth-card card shadow-sm p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h3 class="visually-hidden">Sign in</h3>
                        <div class="d-none d-md-block text-muted small">Secure sign in</div>
                    </div>
                    <form action="/login" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <input name="username" id="username" type="text" class="form-control form-control-lg" placeholder="Username or email" required />
                        </div>
                        <div class="mb-3">
                            <input name="password" id="password" type="password" class="form-control form-control-lg" placeholder="Password" required />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <a href="#" class="text-muted small">Forgot password?</a>
                        </div>
                        <div class="d-grid mb-2">
                            <button class="btn btn-brand btn-lg" type="submit">Log in</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>