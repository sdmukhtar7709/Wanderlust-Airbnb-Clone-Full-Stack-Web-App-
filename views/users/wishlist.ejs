<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <div class="card shadow-sm p-4">
        <h2 class="mb-3">My Wishlist</h2>
        <% if (wishlist.length === 0) { %>
          <div class="alert alert-info">Your wishlist is empty. Browse listings and tap the heart to save stays here.</div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            <% wishlist.forEach(listing => { %>
              <div class="col">
                <div class="card h-100 listing-card">
                  <a href="/listings/<%= listing._id %>" class="text-decoration-none text-reset">
                    <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1400&q=80' %>" class="card-img-top" alt="<%= listing.title %>">
                    <div class="card-body">
                      <h5 class="card-title"><%= listing.title %></h5>
                      <p class="card-text text-muted mb-1"><%= listing.location || 'Handpicked stay' %></p>
                      <p class="card-text fw-bold">₹<%= Math.round(listing.price * 1.10).toLocaleString('en-IN') %> / night</p>
                    </div>
                  </a>
                  <form action="/wishlist/<%= listing._id %>" method="POST" class="p-3">
                    <button type="submit" class="btn btn-outline-danger w-100">Remove from wishlist</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
